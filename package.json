{
  "name": "taskflow-cli",
  "version": "1.2.0",
  "description": "A fast, terminal-based task manager built with TypeScript",
  "main": "dist/index.js",
  "bin": {
    "taskflow": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest --reporter=verbose",
    "lint": "tsc --noEmit"
  },
  "keywords": ["cli", "task-manager", "todo", "typescript", "productivity"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.2",
    "vitest": "^1.6.0"
  }
}
